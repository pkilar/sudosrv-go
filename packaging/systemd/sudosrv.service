# The single systemd unit, installed verbatim by all three packaging formats.
#
# It is shared rather than kept per-format because nothing in it differs by
# distribution: there is no EnvironmentFile (the config path is a fixed
# argument) and no reference to the one path that does differ between formats,
# the logsh helper directory. Keeping one copy is what stops the hardening
# stanzas below drifting apart, which is exactly what happened to the config
# and unit files this replaces.
#
# ExecReload uses /bin/kill, which is not in every base image -- each format
# declares the package that provides it (procps / util-linux / procps-ng).
[Unit]
Description=sudo I/O Log Server
Documentation=man:sudosrv(8)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=sudosrv
Group=sudosrv
ExecStart=/usr/bin/sudosrv -config=/etc/sudosrv/config.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=30s

# Security settings
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/log/sudosrv /var/spool/sudosrv-cache
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target
