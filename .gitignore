# Go Sudo I/O Log Server .gitignore

# Compiled binary
/sudosrv*
/sudosrv.exe
/logsh
/logsh-linux-*
/wiredump

# Local configuration files
# These often contain secrets or local paths and should not be committed.
# A template or example file (e.g., config.example.yaml) should be committed instead.
/config.yaml
*.key
*.crt
*.pem

# Log files and directories
# The server's own operational logs and the sudo I/O logs it stores.
*.log
local-logs/
/var/log/gosudo-io/

# Go build cache and dependencies
bin/
vendor/
*.test
*.prof
cover.out
test.coverprofile
.cache/
.config/

*.tar.gz

# Packaging build trees. Generated by packaging/*/build-*.sh, never committed.
/rpmbuild/
/debbuild/
/archbuild/

# OS-specific files
.DS_Store
Thumbs.db
._*

# IDE and editor directories
.vscode/
.idea/
*.swp
*~
.claude/
.claude.json
CLAUDE.md
sudosrv.code-workspace

# Workspace for the superpowers spec/plan/execution-ledger flow. These are
# working artefacts for producing a change, not part of the change: the design
# rationale that outlives them belongs in doc comments and the runbooks under
# docs/, and the rest is superseded by git history once the work lands.
docs/superpowers/
.superpowers/
