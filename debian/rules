#!/usr/bin/make -f

export DH_VERBOSE = 1
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export DEB_LDFLAGS_MAINT_APPEND = -Wl,--as-needed

# Go build flags
export GOOS = linux
export CGO_ENABLED = 0

%:
	dh $@

override_dh_auto_configure:
	# Use the Makefile's proto target rather than invoking protoc directly.
	# protoc needs protoc-gen-go on PATH, and Debian's protobuf-compiler does not
	# ship it, so the direct call failed with "protoc-gen-go: program not found"
	# and the package could not be built at all. The Makefile resolves the plugin
	# through `go tool`, pinned by the tool directive in go.mod, so the generator
	# always matches the protobuf runtime this module compiles against.
	$(MAKE) proto

override_dh_auto_build:
	# Build the application
	go build -ldflags="-s -w" -o sudosrv ./cmd/sudosrv
	# logsh is always CGO-free (set globally above): it is a login shell, so a
	# dynamic linker that cannot resolve it prevents login rather than degrading
	# it. See LOGSH_ENV in the Makefile.
	go build -trimpath -ldflags="-s -w" -o logsh ./cmd/logsh

override_dh_auto_install:
	# Install binary
	install -D -m 0755 sudosrv $(CURDIR)/debian/sudosrv/usr/bin/sudosrv
	
	# Install configuration
	install -D -m 0644 config.yaml $(CURDIR)/debian/sudosrv/etc/sudosrv/config.yaml
	
	# Install systemd service
	install -D -m 0644 rpm/SOURCES/sudosrv.service $(CURDIR)/debian/sudosrv/lib/systemd/system/sudosrv.service
	
	# Create log and cache directories
	install -d -m 0755 $(CURDIR)/debian/sudosrv/var/log/sudosrv
	install -d -m 0755 $(CURDIR)/debian/sudosrv/var/spool/sudosrv-cache

	# --- logsh -------------------------------------------------------------
	install -D -m 0755 logsh $(CURDIR)/debian/logsh/usr/sbin/logsh
	# The install script the maintainer scripts drive. Not in PATH: it is
	# packaging machinery, and an operator reaches it through the documented
	# path in the runbook.
	install -D -m 0755 packaging/logsh/logsh-install.sh \
		$(CURDIR)/debian/logsh/usr/libexec/logsh/logsh-install.sh
	# 0644, not 0600: logsh runs as the logging-in user and must be able to read
	# this. Root-owned and not group- or world-writable is what matters.
	install -D -m 0644 examples/logsh.yaml \
		$(CURDIR)/debian/logsh/etc/logsh/logsh.yaml
	install -D -m 0644 docs/logsh-deployment.md \
		$(CURDIR)/debian/logsh/usr/share/doc/logsh/logsh-deployment.md

	# The symlinks and the /etc/shells entries are deliberately NOT shipped as
	# package files. /etc/shells is a shared file no package owns, so it has to
	# be edited by script either way, and splitting ownership -- dpkg for the
	# symlinks, a script for the registration -- means removal has two masters.
	# logsh-install.sh owns both, and its uninstall path is tested.

override_dh_auto_test:
	# Run tests
	# 30s could not even finish internal/relay, so this target failed and the
	# package could not be built at all. Build hosts are slower than laptops;
	# skip tests entirely with DEB_BUILD_OPTIONS=nocheck where ptrace or a pty
	# is unavailable (see the logshell suite).
	go test -timeout 600s ./...

override_dh_auto_clean:
	# Clean build artifacts
	rm -f sudosrv logsh
	dh_auto_clean